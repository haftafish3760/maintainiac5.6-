rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(uid);
    }

    function memberDoc(orgId) {
      return get(memberPath(orgId, request.auth.uid));
    }

    function isActiveMember(orgId) {
      return signedIn() &&
        exists(memberPath(orgId, request.auth.uid)) &&
        memberDoc(orgId).data.status == 'active';
    }

    function hasRole(orgId, roles) {
      return isActiveMember(orgId) && memberDoc(orgId).data.role in roles;
    }

    function isOwnerOrAdmin(orgId) {
      return hasRole(orgId, ['owner', 'admin']);
    }

    function hasPermission(orgId, permission) {
      return isActiveMember(orgId) &&
        permission in memberDoc(orgId).data.permissions;
    }

    function hasModule(orgId, module) {
      return isActiveMember(orgId) &&
        module in memberDoc(orgId).data.allowedModules;
    }

    function writesOwnCreate() {
      return signedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid;
    }

    function keepsCreator() {
      return signedIn() &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.updatedByUid == request.auth.uid;
    }

    function assignedToMember() {
      return signedIn() &&
        request.auth.uid in resource.data.assignedMemberIds;
    }

    function incomingAssignedToMember() {
      return signedIn() &&
        request.auth.uid in request.resource.data.assignedMemberIds;
    }

    function inventoryAssignedToMember() {
      return signedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        (
          resource.data.keys().hasAny(['assignedMemberIds']) &&
          request.auth.uid in resource.data.assignedMemberIds
        )
      );
    }

    function hasForbiddenSensitiveFields() {
      return request.resource.data.keys().hasAny([
        'vin',
        'VIN',
        'vehicleIdentificationNumber',
        'licensePlate',
        'plate',
        'plateNumber',
        'tagNumber',
        'passengerName',
        'passengerPhone',
        'passengerAddress',
        'patientName',
        'patientPhone',
        'patientAddress',
        'medicalRecordNumber',
        'diagnosis',
        'dateOfBirth',
        'dob',
      ]);
    }

    function noForbiddenSensitiveFields() {
      return !hasForbiddenSensitiveFields();
    }

    function noLocationTrackingFields() {
      return !request.resource.data.keys().hasAny([
        'latitude',
        'longitude',
        'coordinates',
        'accuracy',
        'speed',
        'location',
        'route',
        'routePoints',
        'routeSummary',
        'polyline',
        'geohash',
        'placeId',
        'address',
        'stopAddress',
        'stopAddresses',
        'sourceLocations',
        'rawSamples',
        'liveLocation',
        'walkingEvidence',
        'activityEvidence',
      ]);
    }

    function isMileageOnlySummary() {
      return request.resource.data.schema == 'trip_tracking_review_v1' &&
        request.resource.data.locationDataIncluded == false &&
        request.resource.data.visibilityScope == 'mileage_only';
    }

    // A deny-list cannot reliably protect privacy as native platforms add new
    // location fields. Mileage backups have a deliberately small, stable
    // document shape, so reject every field the client does not explicitly
    // need for a reviewed mileage summary.
    function hasOnlyMileageSummaryFields() {
      return request.resource.data.keys().hasOnly([
        'schema',
        'tripId',
        'orgId',
        'organizationSharingConsent',
        'createdByUid',
        'updatedByUid',
        'vehicleId',
        'profile',
        'startedAt',
        'finishedAt',
        'createdAt',
        'updatedAt',
        'startingOdometer',
        'estimatedEndingOdometer',
        'confirmedEndingOdometer',
        'odometerConfirmedAt',
        'acceptedMeters',
        'acceptedMiles',
        'walkingReviewSuggested',
        'motionState',
        'receivedSampleCount',
        'acceptedSampleCount',
        'locationDataIncluded',
        'visibilityScope',
      ]);
    }

    function hasRequiredMileageSummaryFields() {
      return request.resource.data.keys().hasAll([
        'schema',
        'tripId',
        'createdByUid',
        'updatedByUid',
        'vehicleId',
        'profile',
        'startedAt',
        'finishedAt',
        'createdAt',
        'updatedAt',
        'startingOdometer',
        'estimatedEndingOdometer',
        'confirmedEndingOdometer',
        'odometerConfirmedAt',
        'acceptedMeters',
        'acceptedMiles',
        'walkingReviewSuggested',
        'motionState',
        'receivedSampleCount',
        'acceptedSampleCount',
        'locationDataIncluded',
        'visibilityScope',
      ]);
    }

    function hasValidMileageSummaryValues() {
      return request.resource.data.tripId is string &&
        request.resource.data.tripId.size() > 0 &&
        request.resource.data.createdByUid is string &&
        request.resource.data.createdByUid.size() > 0 &&
        request.resource.data.updatedByUid is string &&
        request.resource.data.updatedByUid.size() > 0 &&
        request.resource.data.vehicleId is string &&
        request.resource.data.vehicleId.size() > 0 &&
        isAllowedTripProfile(request.resource.data.profile) &&
        request.resource.data.startedAt is string &&
        request.resource.data.startedAt.size() > 0 &&
        request.resource.data.finishedAt is string &&
        request.resource.data.finishedAt.size() > 0 &&
        request.resource.data.finishedAt >= request.resource.data.startedAt &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() > 0 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() > 0 &&
        request.resource.data.startingOdometer is int &&
        request.resource.data.startingOdometer >= 0 &&
        request.resource.data.estimatedEndingOdometer is int &&
        request.resource.data.estimatedEndingOdometer >=
          request.resource.data.startingOdometer &&
        request.resource.data.confirmedEndingOdometer is int &&
        request.resource.data.confirmedEndingOdometer >=
          request.resource.data.startingOdometer &&
        request.resource.data.odometerConfirmedAt is string &&
        request.resource.data.odometerConfirmedAt.size() > 0 &&
        request.resource.data.odometerConfirmedAt >=
          request.resource.data.finishedAt &&
        request.resource.data.acceptedMeters is number &&
        request.resource.data.acceptedMeters >= 0 &&
        request.resource.data.acceptedMiles is number &&
        request.resource.data.acceptedMiles >= 0 &&
        request.resource.data.walkingReviewSuggested is bool &&
        isAllowedTripMotionState(request.resource.data.motionState) &&
        request.resource.data.receivedSampleCount is int &&
        request.resource.data.receivedSampleCount >= 0 &&
        request.resource.data.acceptedSampleCount is int &&
        request.resource.data.acceptedSampleCount >= 0 &&
        request.resource.data.acceptedSampleCount <=
          request.resource.data.receivedSampleCount;
    }

    function isAllowedTripProfile(value) {
      return [
        'roadVehicle',
        'rideshareVehicle',
        'deliveryVehicle',
        'contractorVehicle',
        'lowSpeedEquipment'
      ].hasAny([value]);
    }

    function isAllowedTripMotionState(value) {
      return [
        'unknown',
        'moving',
        'stopCandidate',
        'stopped'
      ].hasAny([value]);
    }

    function hasCoherentMileageSummaryDistance() {
      let acceptedMiles = request.resource.data.acceptedMiles;
      let acceptedMeters = request.resource.data.acceptedMeters;
      let odometerDelta =
        request.resource.data.estimatedEndingOdometer -
        request.resource.data.startingOdometer;
      return acceptedMeters >= (acceptedMiles - 0.01) * 1609.344 &&
        acceptedMeters <= (acceptedMiles + 0.01) * 1609.344 &&
        acceptedMiles >= odometerDelta - 0.5 &&
        acceptedMiles < odometerDelta + 0.5;
    }

    function hasOnlyDashboardSummaryFields() {
      return request.resource.data.keys().hasOnly([
        'schema',
        'dashboardId',
        'orgId',
        'createdByUid',
        'updatedByUid',
        'updatedAt',
        'activeVehicleId',
        'activeWorkdayId',
        'activeWorkProfileId',
        'dashboardMode',
        'mileageMode',
        'syncMode',
        'gpsAssistState',
        'storageState',
        'freeSyncsRemaining',
        'syncsUsedInWindow',
        'batteryGpsLimited',
        'reviewRequired',
        'locationDataIncluded',
        'rawModuleDataIncluded',
      ]);
    }

    function hasRequiredDashboardSummaryFields() {
      return request.resource.data.keys().hasAll([
        'schema',
        'dashboardId',
        'createdByUid',
        'updatedByUid',
        'updatedAt',
        'dashboardMode',
        'mileageMode',
        'syncMode',
        'gpsAssistState',
        'storageState',
        'batteryGpsLimited',
        'reviewRequired',
        'locationDataIncluded',
        'rawModuleDataIncluded',
      ]);
    }

    function hasValidDashboardSyncCounters() {
      return (!request.resource.data.keys().hasAny(['freeSyncsRemaining']) ||
          (request.resource.data.freeSyncsRemaining is int &&
            request.resource.data.freeSyncsRemaining >= 0 &&
            request.resource.data.freeSyncsRemaining <= 6)) &&
        (!request.resource.data.keys().hasAny(['syncsUsedInWindow']) ||
          (request.resource.data.syncsUsedInWindow is int &&
            request.resource.data.syncsUsedInWindow >= 0 &&
            request.resource.data.syncsUsedInWindow <= 999));
    }

    function hasValidDashboardSummaryStrings() {
      return request.resource.data.dashboardId is string &&
        request.resource.data.dashboardId.size() > 0 &&
        request.resource.data.dashboardId.size() <= 128 &&
        request.resource.data.createdByUid is string &&
        request.resource.data.createdByUid.size() > 0 &&
        request.resource.data.createdByUid.size() <= 128 &&
        request.resource.data.updatedByUid is string &&
        request.resource.data.updatedByUid.size() > 0 &&
        request.resource.data.updatedByUid.size() <= 128 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() > 0 &&
        (!request.resource.data.keys().hasAny(['orgId']) ||
          (request.resource.data.orgId is string &&
            request.resource.data.orgId.size() > 0 &&
            request.resource.data.orgId.size() <= 128)) &&
        (!request.resource.data.keys().hasAny(['activeVehicleId']) ||
          (request.resource.data.activeVehicleId is string &&
            request.resource.data.activeVehicleId.size() > 0 &&
            request.resource.data.activeVehicleId.size() <= 128)) &&
        (!request.resource.data.keys().hasAny(['activeWorkdayId']) ||
          (request.resource.data.activeWorkdayId is string &&
            request.resource.data.activeWorkdayId.size() > 0 &&
            request.resource.data.activeWorkdayId.size() <= 128)) &&
        (!request.resource.data.keys().hasAny(['activeWorkProfileId']) ||
          (request.resource.data.activeWorkProfileId is string &&
            request.resource.data.activeWorkProfileId.size() > 0 &&
            request.resource.data.activeWorkProfileId.size() <= 128));
    }

    function isAllowedDashboardMode(value) {
      return [
        'default',
        'gig_driver',
        'contractor',
        'solo_contractor',
        'fleet_owner',
        'employee',
        'customer',
        'personal',
        'gigDriver',
        'soloContractor',
        'fleetOwner'
      ].hasAny([value]);
    }

    function isAllowedMileageMode(value) {
      return [
        'manual',
        'gps_assisted',
        'workday',
        'employee_shift',
        'fleet_review',
        'customer_hidden',
        'employeeShift',
        'fleetReview',
        'customerHidden'
      ].hasAny([value]);
    }

    function isAllowedDashboardSyncMode(value) {
      return [
        'device_retained',
        'local_only',
        'wifi_only',
        'wifi_and_mobile',
        'mobile_only',
        'firebase_backup',
        'company_sync',
        'localOnly',
        'firebaseBackup',
        'companySync'
      ].hasAny([value]);
    }

    function isAllowedGpsAssistState(value) {
      return [
        'off',
        'on',
        'gps_assisted',
        'battery_limited',
        'permission_denied',
        'unavailable'
      ].hasAny([value]);
    }

    function isAllowedDashboardStorageState(value) {
      return [
        'unknown',
        'green',
        'text_record_safe',
        'low_storage',
        'full',
        'local_only',
        'cloud_pending'
      ].hasAny([value]);
    }

    function isDashboardCommandCenterSummary() {
      return request.resource.data.schema ==
          'dashboard_command_center_summary_v1' &&
        request.resource.data.locationDataIncluded == false &&
        request.resource.data.rawModuleDataIncluded == false &&
        hasOnlyDashboardSummaryFields() &&
        hasRequiredDashboardSummaryFields() &&
        noLocationTrackingFields() &&
        noForbiddenSensitiveFields() &&
        hasValidDashboardSyncCounters() &&
        hasValidDashboardSummaryStrings() &&
        isAllowedDashboardMode(request.resource.data.dashboardMode) &&
        isAllowedMileageMode(request.resource.data.mileageMode) &&
        isAllowedDashboardSyncMode(request.resource.data.syncMode) &&
        isAllowedGpsAssistState(request.resource.data.gpsAssistState) &&
        isAllowedDashboardStorageState(request.resource.data.storageState) &&
        request.resource.data.batteryGpsLimited is bool &&
        request.resource.data.reviewRequired is bool;
    }

    function noServerManagedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'plan',
        'cloudBytesUsed',
        'monthlyCloudBytesLimit',
        'exportCount',
        'monthlyExportLimit',
        'aiInputTokens',
        'aiOutputTokens',
        'functionCallCount',
        'billingStatus',
        'blockedReason',
        'riskScore',
        'abuseFlags',
        'quotaOverride',
      ]);
    }

    function keepsServerManagedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'cloudBytesUsed',
        'monthlyCloudBytesLimit',
        'exportCount',
        'monthlyExportLimit',
        'aiInputTokens',
        'aiOutputTokens',
        'functionCallCount',
        'billingStatus',
        'blockedReason',
        'riskScore',
        'abuseFlags',
        'quotaOverride',
      ]);
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) &&
        request.resource.data.uid == uid &&
        noServerManagedFieldsOnCreate() &&
        noForbiddenSensitiveFields();
      allow update: if isSelf(uid) &&
        request.resource.data.uid == resource.data.uid &&
        keepsServerManagedFields() &&
        noForbiddenSensitiveFields();
      allow delete: if false;

      match /mileageRecords/{recordId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) &&
          request.resource.data.createdByUid == uid &&
          request.resource.data.updatedByUid == uid &&
          isMileageOnlySummary() &&
          hasOnlyMileageSummaryFields() &&
          hasRequiredMileageSummaryFields() &&
          hasValidMileageSummaryValues() &&
          hasCoherentMileageSummaryDistance() &&
          request.resource.data.tripId == recordId &&
          !request.resource.data.keys().hasAny([
            'orgId',
            'organizationSharingConsent',
          ]);
        // Reviewed mileage is an audit record, not a mutable cloud draft.
        // Permit an exact replay by its creator so an interrupted upload can
        // be retried idempotently, but reject every material change.
        allow update: if isSelf(uid) &&
          exists(/databases/$(database)/documents/users/$(uid)/mileageRecords/$(recordId)) &&
          resource.data.createdByUid == uid &&
          request.resource.data == resource.data;
        allow delete: if false;
      }

      match /dashboardSummaries/{dashboardId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) &&
          request.resource.data.dashboardId == dashboardId &&
          request.resource.data.createdByUid == uid &&
          request.resource.data.updatedByUid == uid &&
          isDashboardCommandCenterSummary() &&
          !request.resource.data.keys().hasAny(['orgId']);
        allow update: if isSelf(uid) &&
          resource.data.createdByUid == uid &&
          request.resource.data.dashboardId == resource.data.dashboardId &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.updatedByUid == uid &&
          isDashboardCommandCenterSummary() &&
          !request.resource.data.keys().hasAny(['orgId']);
        allow delete: if false;
      }
    }

    match /usage/{uid}/months/{monthId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /abuseSignals/{signalId} {
      allow read, write: if false;
    }

    match /aiAbuseSecurityEvents/{eventId} {
      allow read, write: if false;
    }

    match /aiEnforcementActions/{actionId} {
      allow read, write: if false;
    }

    match /accountAbuseInstalls/{installId} {
      allow read, write: if false;
    }

    match /accountAbuseIpWindows/{ipWindowId} {
      allow read, write: if false;
    }

    match /accountCreationReviews/{reviewId} {
      allow read, write: if false;
    }

    match /orgs/{orgId} {
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        noServerManagedFieldsOnCreate();
      allow read: if isActiveMember(orgId);
      allow update: if isOwnerOrAdmin(orgId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        keepsServerManagedFields();
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isSelf(memberUid) || isOwnerOrAdmin(orgId);
        // A newly authenticated independent user must be able to enroll the
        // first owner member after creating their private workspace. The owner
        // may only enroll themself, as an active owner, and cannot use this
        // narrow bootstrap rule to add another person.
        allow create: if (
            isOwnerOrAdmin(orgId) ||
            (
              signedIn() &&
              request.auth.uid == memberUid &&
              get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid &&
              request.resource.data.uid == memberUid &&
              request.resource.data.orgId == orgId &&
              request.resource.data.status == 'active' &&
              request.resource.data.role == 'owner'
            )
          ) &&
          request.resource.data.uid == memberUid &&
          request.resource.data.orgId == orgId;
        allow update: if isOwnerOrAdmin(orgId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.orgId == resource.data.orgId;
        allow delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          (signedIn() && resource.data.email == request.auth.token.email);
        allow create: if isOwnerOrAdmin(orgId) &&
          request.resource.data.orgId == orgId &&
          request.resource.data.invitedByUid == request.auth.uid;
        allow update: if isOwnerOrAdmin(orgId) &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.invitedByUid == resource.data.invitedByUid;
        allow delete: if false;
      }

      match /uploadGrants/{grantId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          (isActiveMember(orgId) && resource.data.uid == request.auth.uid);
        allow write: if false;
      }

      match /storageQuotas/{uid} {
        allow read: if isOwnerOrAdmin(orgId) ||
          (isActiveMember(orgId) && isSelf(uid));
        allow write: if false;
      }

      match /exports/{exportId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAuditLog');
        allow write: if false;
      }

      match /syncManifests/{manifestId} {
        allow read: if isActiveMember(orgId);
        allow write: if false;
      }

      match /settings/{settingsId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if isActiveMember(orgId) &&
          request.resource.data.orgId == orgId &&
          (
            isOwnerOrAdmin(orgId) ||
            request.resource.data.ownerUid == request.auth.uid ||
            request.resource.data.createdByUid == request.auth.uid
          ) &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if isActiveMember(orgId) &&
          request.resource.data.orgId == resource.data.orgId &&
          (
            isOwnerOrAdmin(orgId) ||
            resource.data.ownerUid == request.auth.uid ||
            resource.data.createdByUid == request.auth.uid
          ) &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }

      match /expenseTelemetrySummaries/{summaryId} {
        allow read: if isOwnerOrAdmin(orgId);
        allow write: if false;
      }

      match /vehicles/{vehicleId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllVehicles') ||
          (hasPermission(orgId, 'viewAssignedVehicles') && assignedToMember());
        allow create: if hasPermission(orgId, 'manageVehicles') &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if hasPermission(orgId, 'editVehicleProfiles') &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllExpenses') ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasModule(orgId, 'expenses') &&
          (
            hasPermission(orgId, 'recordExpenses') ||
            hasPermission(orgId, 'addOwnReceipts') ||
            hasPermission(orgId, 'addCompanyExpenses')
          ) &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'editCompanyExpenses') ||
            (
              hasPermission(orgId, 'editOwnReceipts') &&
              resource.data.createdByUid == request.auth.uid
            )
          ) &&
          keepsCreator();
        allow delete: if isOwnerOrAdmin(orgId);
      }

      match /mileageRecords/{recordId} {
        allow read: if (
            isOwnerOrAdmin(orgId) ||
            hasPermission(orgId, 'viewFleetMileageReports')
          ) && resource.data.organizationSharingConsent == true ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasPermission(orgId, 'recordMileage') &&
          writesOwnCreate() &&
          isMileageOnlySummary() &&
          hasOnlyMileageSummaryFields() &&
          hasRequiredMileageSummaryFields() &&
          hasValidMileageSummaryValues() &&
          hasCoherentMileageSummaryDistance() &&
          request.resource.data.tripId == recordId &&
          request.resource.data.orgId == orgId &&
          request.resource.data.organizationSharingConsent == true;
        // An employer/fleet role can view consented mileage but cannot alter
        // a driver's reviewed record. The creator may only replay an exact
        // document after a client-side retry ambiguity.
        allow update: if exists(/databases/$(database)/documents/orgs/$(orgId)/mileageRecords/$(recordId)) &&
          resource.data.createdByUid == request.auth.uid &&
          request.resource.data == resource.data;
        allow delete: if false;
      }

      match /dashboardSummaries/{dashboardId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if isActiveMember(orgId) &&
          request.resource.data.dashboardId == dashboardId &&
          request.resource.data.orgId == orgId &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.updatedByUid == request.auth.uid &&
          isDashboardCommandCenterSummary();
        allow update: if isActiveMember(orgId) &&
          resource.data.createdByUid == request.auth.uid &&
          request.resource.data.dashboardId == resource.data.dashboardId &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.updatedByUid == request.auth.uid &&
          isDashboardCommandCenterSummary();
        allow delete: if false;
      }

      match /jobs/{jobId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllJobs') ||
          (
            hasPermission(orgId, 'viewAssignedJobs') &&
            request.auth.uid in resource.data.assignedMemberIds
          );
        allow create: if hasPermission(orgId, 'createJobs') &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if hasPermission(orgId, 'editJobs') &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }

      match /estimates/{estimateId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'createEstimates') ||
          hasPermission(orgId, 'sendEstimates') ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasPermission(orgId, 'createEstimates') &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'createEstimates') ||
            hasPermission(orgId, 'approveEstimates') ||
            hasPermission(orgId, 'sendEstimates')
          ) &&
          keepsCreator();
        allow delete: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'createInvoices') ||
          hasPermission(orgId, 'sendInvoices') ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasPermission(orgId, 'createInvoices') &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'createInvoices') ||
            hasPermission(orgId, 'approveInvoices') ||
            hasPermission(orgId, 'recordPayments') ||
            hasPermission(orgId, 'sendInvoices')
          ) &&
          keepsCreator();
        allow delete: if false;
      }

      match /inventoryItems/{itemId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllInventory') ||
          (
            hasPermission(orgId, 'viewAssignedInventory') &&
            inventoryAssignedToMember()
          );
        allow create: if hasPermission(orgId, 'manageInventory') &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'manageInventory') ||
            hasPermission(orgId, 'addStock') ||
            hasPermission(orgId, 'useMaterials') ||
            hasPermission(orgId, 'transferMaterials') ||
            hasPermission(orgId, 'adjustInventoryCounts')
          ) &&
          keepsCreator();
        allow delete: if false;
      }

      match /inventoryTransactions/{transactionId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllInventory') ||
          (
            hasPermission(orgId, 'viewAssignedInventory') &&
            inventoryAssignedToMember()
          );
        allow create: if (
            hasPermission(orgId, 'addStock') ||
            hasPermission(orgId, 'useMaterials') ||
            hasPermission(orgId, 'transferMaterials') ||
            hasPermission(orgId, 'adjustInventoryCounts')
          ) &&
          writesOwnCreate();
        allow update, delete: if false;
      }

      match /maintenanceRecords/{recordId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllMaintenance') ||
          (
            hasPermission(orgId, 'viewAssignedMaintenance') &&
            request.auth.uid in resource.data.assignedMemberIds
          );
        allow create: if hasPermission(orgId, 'logMaintenance') &&
          writesOwnCreate();
        allow update: if hasPermission(orgId, 'editMaintenanceRecords') &&
          keepsCreator();
        allow delete: if false;
      }

      match /financialSummaries/{summaryId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewFinancials') ||
          hasPermission(orgId, 'viewProfitLoss');
        allow write: if isOwnerOrAdmin(orgId);
      }

      match /records/{recordId} {
        allow read: if isActiveMember(orgId) &&
          resource.data.privateToOwner != true;
        allow create: if isActiveMember(orgId) &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if isActiveMember(orgId) &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }
    }

    match /catalogPacks/{packId} {
      allow read: if true;
      allow write: if false;

      match /manifests/{versionId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /vendorRegistry/{vendorId} {
      allow read: if true;
      allow write: if false;

      match /profiles/{profileId} {
        allow read: if true;
        allow write: if false;
      }

      match /aliases/{aliasId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /parserHealth/{parserVersion} {
      allow read, write: if false;
    }

    match /catalogHealth/{healthId} {
      allow read, write: if false;
    }

    match /sharedCorrectionCandidates/{candidateId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
