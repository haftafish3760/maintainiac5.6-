rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(uid);
    }

    function memberDoc(orgId) {
      return get(memberPath(orgId, request.auth.uid));
    }

    function isActiveMember(orgId) {
      return signedIn() &&
        exists(memberPath(orgId, request.auth.uid)) &&
        memberDoc(orgId).data.status == 'active';
    }

    function hasRole(orgId, roles) {
      return isActiveMember(orgId) && memberDoc(orgId).data.role in roles;
    }

    function isOwnerOrAdmin(orgId) {
      return hasRole(orgId, ['owner', 'admin']);
    }

    function hasPermission(orgId, permission) {
      return isActiveMember(orgId) &&
        permission in memberDoc(orgId).data.permissions;
    }

    function hasModule(orgId, module) {
      return isActiveMember(orgId) &&
        module in memberDoc(orgId).data.allowedModules;
    }

    function writesOwnCreate() {
      return signedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid;
    }

    function keepsCreator() {
      return signedIn() &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.updatedByUid == request.auth.uid;
    }

    function assignedToMember() {
      return signedIn() &&
        request.auth.uid in resource.data.assignedMemberIds;
    }

    function incomingAssignedToMember() {
      return signedIn() &&
        request.auth.uid in request.resource.data.assignedMemberIds;
    }

    function inventoryAssignedToMember() {
      return signedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        (
          resource.data.keys().hasAny(['assignedMemberIds']) &&
          request.auth.uid in resource.data.assignedMemberIds
        )
      );
    }

    function hasForbiddenSensitiveFields() {
      return request.resource.data.keys().hasAny([
        'vin',
        'VIN',
        'vehicleIdentificationNumber',
        'licensePlate',
        'plate',
        'plateNumber',
        'tagNumber',
        'passengerName',
        'passengerPhone',
        'passengerAddress',
        'patientName',
        'patientPhone',
        'patientAddress',
        'medicalRecordNumber',
        'diagnosis',
        'dateOfBirth',
        'dob',
      ]);
    }

    function noForbiddenSensitiveFields() {
      return !hasForbiddenSensitiveFields();
    }

    function noLocationTrackingFields() {
      return !request.resource.data.keys().hasAny([
        'latitude',
        'longitude',
        'coordinates',
        'accuracy',
        'speed',
        'location',
        'route',
        'mapboxRoute',
        'mapboxGeometry',
        'mapboxPolyline',
        'mapMatching',
        'optimizationRoute',
        'directionsRoute',
        'routePoints',
        'routeSummary',
        'polyline',
        'geometry',
        'geometries',
        'waypoint',
        'waypoints',
        'leg',
        'legs',
        'maneuver',
        'maneuvers',
        'navigationRoute',
        'directions',
        'matrix',
        'durations',
        'distances',
        'isochrone',
        'contours',
        'optimization',
        'optimizedWaypoints',
        'mapMatchedTrace',
        'tracepoints',
        'evChargeFinder',
        'chargingStation',
        'chargingStations',
        'stationCoordinates',
        'geohash',
        'placeId',
        'address',
        'stopAddress',
        'stopAddresses',
        'sourceLocations',
        'rawSamples',
        'liveLocation',
        'walkingEvidence',
        'activityEvidence',
      ]);
    }

    function isMileageOnlySummary() {
      return request.resource.data.schema == 'trip_tracking_review_v1' &&
        request.resource.data.locationDataIncluded == false &&
        request.resource.data.visibilityScope == 'mileage_only';
    }

    // A deny-list cannot reliably protect privacy as native platforms add new
    // location fields. Mileage backups have a deliberately small, stable
    // document shape, so reject every field the client does not explicitly
    // need for a reviewed mileage summary.
    function hasOnlyMileageSummaryFields() {
      return request.resource.data.keys().hasOnly([
        'schema',
        'tripId',
        'orgId',
        'organizationSharingConsent',
        'createdByUid',
        'updatedByUid',
        'vehicleId',
        'profile',
        'startedAt',
        'finishedAt',
        'createdAt',
        'updatedAt',
        'startingOdometer',
        'estimatedEndingOdometer',
        'confirmedEndingOdometer',
        'odometerConfirmedAt',
        'acceptedMeters',
        'acceptedMiles',
        'walkingReviewSuggested',
        'motionState',
        'receivedSampleCount',
        'acceptedSampleCount',
        'locationDataIncluded',
        'visibilityScope',
      ]);
    }

    function hasRequiredMileageSummaryFields() {
      return request.resource.data.keys().hasAll([
        'schema',
        'tripId',
        'createdByUid',
        'updatedByUid',
        'vehicleId',
        'profile',
        'startedAt',
        'finishedAt',
        'createdAt',
        'updatedAt',
        'startingOdometer',
        'estimatedEndingOdometer',
        'confirmedEndingOdometer',
        'odometerConfirmedAt',
        'acceptedMeters',
        'acceptedMiles',
        'walkingReviewSuggested',
        'motionState',
        'receivedSampleCount',
        'acceptedSampleCount',
        'locationDataIncluded',
        'visibilityScope',
      ]);
    }

    function hasValidMileageSummaryValues() {
      return request.resource.data.tripId is string &&
        request.resource.data.tripId.size() > 0 &&
        request.resource.data.createdByUid is string &&
        request.resource.data.createdByUid.size() > 0 &&
        request.resource.data.updatedByUid is string &&
        request.resource.data.updatedByUid.size() > 0 &&
        request.resource.data.vehicleId is string &&
        request.resource.data.vehicleId.size() > 0 &&
        isAllowedTripProfile(request.resource.data.profile) &&
        request.resource.data.startedAt is string &&
        request.resource.data.startedAt.size() > 0 &&
        request.resource.data.finishedAt is string &&
        request.resource.data.finishedAt.size() > 0 &&
        request.resource.data.finishedAt >= request.resource.data.startedAt &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() > 0 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() > 0 &&
        request.resource.data.startingOdometer is int &&
        request.resource.data.startingOdometer >= 0 &&
        request.resource.data.estimatedEndingOdometer is int &&
        request.resource.data.estimatedEndingOdometer >=
          request.resource.data.startingOdometer &&
        request.resource.data.confirmedEndingOdometer is int &&
        request.resource.data.confirmedEndingOdometer >=
          request.resource.data.startingOdometer &&
        request.resource.data.odometerConfirmedAt is string &&
        request.resource.data.odometerConfirmedAt.size() > 0 &&
        request.resource.data.odometerConfirmedAt >=
          request.resource.data.finishedAt &&
        request.resource.data.acceptedMeters is number &&
        request.resource.data.acceptedMeters >= 0 &&
        request.resource.data.acceptedMiles is number &&
        request.resource.data.acceptedMiles >= 0 &&
        request.resource.data.walkingReviewSuggested is bool &&
        isAllowedTripMotionState(request.resource.data.motionState) &&
        request.resource.data.receivedSampleCount is int &&
        request.resource.data.receivedSampleCount >= 0 &&
        request.resource.data.receivedSampleCount <= 999999 &&
        request.resource.data.acceptedSampleCount is int &&
        request.resource.data.acceptedSampleCount >= 0 &&
        request.resource.data.acceptedSampleCount <= 999999 &&
        request.resource.data.acceptedSampleCount <=
          request.resource.data.receivedSampleCount;
    }

    function isAllowedTripProfile(value) {
      return [
        'roadVehicle',
        'rideshareVehicle',
        'deliveryVehicle',
        'contractorVehicle',
        'lowSpeedEquipment'
      ].hasAny([value]);
    }

    function isAllowedTripMotionState(value) {
      return [
        'unknown',
        'moving',
        'stopCandidate',
        'stopped'
      ].hasAny([value]);
    }

    function hasCoherentMileageSummaryDistance() {
      let acceptedMiles = request.resource.data.acceptedMiles;
      let acceptedMeters = request.resource.data.acceptedMeters;
      let odometerDelta =
        request.resource.data.estimatedEndingOdometer -
        request.resource.data.startingOdometer;
      return acceptedMeters >= (acceptedMiles - 0.01) * 1609.344 &&
        acceptedMeters <= (acceptedMiles + 0.01) * 1609.344 &&
        acceptedMiles >= odometerDelta - 0.5 &&
        acceptedMiles < odometerDelta + 0.5;
    }

    function hasOnlyDashboardSummaryFields() {
      return request.resource.data.keys().hasOnly([
        'schema',
        'dashboardId',
        'orgId',
        'createdByUid',
        'updatedByUid',
        'updatedAt',
        'activeVehicleId',
        'activeWorkdayId',
        'activeWorkProfileId',
        'dashboardMode',
        'workStyle',
        'stopDetectionMode',
        'stopReviewReasonCode',
        'stopSignal',
        'stopActionToken',
        'stopClassificationReason',
        'recommendedActivityRecognition',
        'requiresStrongerStopDebounce',
        'recoveryState',
        'recoveryReason',
        'recoveryUserActionRequired',
        'mileageMode',
        'syncMode',
        'gpsAssistState',
        'gpsSignalQuality',
        'gpsSignalReason',
        'gpsSignalReviewRequired',
        'mapboxAssistState',
        'mapboxAssistReason',
        'mapboxAssistReviewRequired',
        'mapboxTrustedMileageSource',
        'mapboxRouteDistanceMiles',
        'mapboxRouteDeltaMiles',
        'mapPreviewEnabled',
        'mapRouteHistorySavingEnabled',
        'mapRouteHistoryDailyBudgetMb',
        'mapRouteHistorySampleIntervalSeconds',
        'mapRouteHistoryState',
        'mapRouteHistoryEstimatedSamplesPerDay',
        'mapRouteHistoryEstimatedDailyMb',
        'storageState',
        'deviceCapabilityState',
        'sensorAssistState',
        'durableRecordBackupState',
        'odometerCalibrationAssistEnabled',
        'odometerCalibrationState',
        'odometerCalibrationSamples',
        'odometerCalibrationMultiplier',
        'odometerUsageState',
        'odometerUsageReviewedDays',
        'odometerUsageCurrentMiles',
        'odometerUsageAverageDailyMiles',
        'odometerUsageReviewThresholdMiles',
        'dashboardWidgetTokens',
        'quickActionTokens',
        'freeSyncsRemaining',
        'syncsUsedInWindow',
        'batteryGpsLimited',
        'reviewRequired',
        'authorizationRequired',
        'authenticationImpliesAuthorization',
        'employeeTrackingRequiresMutualConsent',
        'locationSharingRequiresActiveOptIn',
        'employerGodModeAllowed',
        'preciseLocationIncluded',
        'externalRoutesCanonical',
        'odometerRemainsCanonical',
        'externalServiceWritesAllowed',
        'mapboxCanModifyTripLog',
        'mapboxCanModifyOdometer',
        'mapsRequiredForTracking',
        'mapsRequireSeparateOptIn',
        'mapRouteHistoryRequiresSeparateOptIn',
        'gpsTrackingCanRunWithoutMaps',
        'freeUserControlsDailyMapStorageBudget',
        'locationDataIncluded',
        'mapboxRouteGeometryIncluded',
        'rawMapRouteIncluded',
        'rawModuleDataIncluded',
      ]);
    }

    function hasRequiredDashboardSummaryFields() {
      return request.resource.data.keys().hasAll([
        'schema',
        'dashboardId',
        'createdByUid',
        'updatedByUid',
        'updatedAt',
        'dashboardMode',
        'workStyle',
        'stopDetectionMode',
        'stopReviewReasonCode',
        'stopSignal',
        'stopActionToken',
        'stopClassificationReason',
        'recommendedActivityRecognition',
        'requiresStrongerStopDebounce',
        'recoveryState',
        'recoveryReason',
        'recoveryUserActionRequired',
        'mileageMode',
        'syncMode',
        'gpsAssistState',
        'gpsSignalQuality',
        'gpsSignalReason',
        'gpsSignalReviewRequired',
        'mapboxAssistState',
        'mapboxAssistReason',
        'mapboxAssistReviewRequired',
        'mapboxTrustedMileageSource',
        'storageState',
        'deviceCapabilityState',
        'sensorAssistState',
        'durableRecordBackupState',
        'odometerCalibrationState',
        'odometerUsageState',
        'batteryGpsLimited',
        'reviewRequired',
        'authorizationRequired',
        'authenticationImpliesAuthorization',
        'employeeTrackingRequiresMutualConsent',
        'locationSharingRequiresActiveOptIn',
        'employerGodModeAllowed',
        'preciseLocationIncluded',
        'externalRoutesCanonical',
        'odometerRemainsCanonical',
        'externalServiceWritesAllowed',
        'mapboxCanModifyTripLog',
        'mapboxCanModifyOdometer',
        'locationDataIncluded',
        'mapboxRouteGeometryIncluded',
        'rawModuleDataIncluded',
      ]);
    }

    function hasValidDashboardSyncCounters() {
      return (!request.resource.data.keys().hasAny(['freeSyncsRemaining']) ||
          (request.resource.data.freeSyncsRemaining is int &&
            request.resource.data.freeSyncsRemaining >= 0 &&
            request.resource.data.freeSyncsRemaining <= 6)) &&
        (!request.resource.data.keys().hasAny(['syncsUsedInWindow']) ||
          (request.resource.data.syncsUsedInWindow is int &&
            request.resource.data.syncsUsedInWindow >= 0 &&
            request.resource.data.syncsUsedInWindow <= 999)) &&
        (!request.resource.data.keys().hasAll([
          'freeSyncsRemaining',
          'syncsUsedInWindow'
        ]) ||
          request.resource.data.freeSyncsRemaining ==
            (request.resource.data.syncsUsedInWindow >= 6
              ? 0
              : 6 - request.resource.data.syncsUsedInWindow));
    }

    function hasValidDashboardSummaryStrings() {
      return request.resource.data.dashboardId is string &&
        request.resource.data.dashboardId.size() > 0 &&
        request.resource.data.dashboardId.size() <= 128 &&
        request.resource.data.createdByUid is string &&
        request.resource.data.createdByUid.size() > 0 &&
        request.resource.data.createdByUid.size() <= 128 &&
        request.resource.data.updatedByUid is string &&
        request.resource.data.updatedByUid.size() > 0 &&
        request.resource.data.updatedByUid.size() <= 128 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() > 0 &&
        (!request.resource.data.keys().hasAny(['orgId']) ||
          (request.resource.data.orgId is string &&
            request.resource.data.orgId.size() > 0 &&
            request.resource.data.orgId.size() <= 128)) &&
        (!request.resource.data.keys().hasAny(['activeVehicleId']) ||
          (request.resource.data.activeVehicleId is string &&
            request.resource.data.activeVehicleId.size() > 0 &&
            request.resource.data.activeVehicleId.size() <= 128)) &&
        (!request.resource.data.keys().hasAny(['activeWorkdayId']) ||
          (request.resource.data.activeWorkdayId is string &&
            request.resource.data.activeWorkdayId.size() > 0 &&
            request.resource.data.activeWorkdayId.size() <= 128)) &&
        (!request.resource.data.keys().hasAny(['activeWorkProfileId']) ||
          (request.resource.data.activeWorkProfileId is string &&
            request.resource.data.activeWorkProfileId.size() > 0 &&
            request.resource.data.activeWorkProfileId.size() <= 128));
    }

    function isAllowedDashboardMode(value) {
      return [
        'default',
        'gig_driver',
        'contractor',
        'solo_contractor',
        'fleet_owner',
        'employee',
        'customer',
        'personal'
      ].hasAny([value]);
    }

    function isAllowedDashboardWorkStyle(value) {
      return [
        'general_road',
        'rideshare',
        'delivery',
        'contractor',
        'equipment'
      ].hasAny([value]);
    }

    function isAllowedDashboardStopDetectionMode(value) {
      return [
        'walking_assisted',
        'strong_debounce',
        'walking_ignored'
      ].hasAny([value]);
    }

    function isAllowedDashboardStopReviewReason(value) {
      return [
        'road_vehicle_stop_walk_review',
        'rideshare_stop_requires_extra_evidence',
        'delivery_stop_walk_review',
        'contractor_stop_walk_review',
        'equipment_ignores_walking_stop_evidence'
      ].hasAny([value]);
    }

    function isAllowedDashboardStopSignal(value) {
      return [
        'no_stop',
        'stop_candidate',
        'review_only_stop',
        'likely_traffic_control',
        'equipment_ignored',
        'unsafe_evidence'
      ].hasAny([value]);
    }

    function isAllowedDashboardStopActionToken(value) {
      return [
        'keep_tracking',
        'continue_monitoring',
        'review_delivery_stop',
        'review_jobsite_stop',
        'review_shift_stop',
        'review_trip_stop'
      ].hasAny([value]);
    }

    function isAllowedDashboardStopClassificationReason(value) {
      return [
        'no_stop_review_needed',
        'unsafe_stop_evidence_rejected',
        'equipment_walking_evidence_ignored',
        'walking_stop_without_vehicle_movement',
        'road_vehicle_stop_walk_review',
        'rideshare_stop_requires_extra_evidence',
        'delivery_stop_walk_review',
        'contractor_stop_walk_review',
        'stop_candidate_waiting_for_stronger_evidence',
        'stop_candidate_waiting_for_confirmation',
        'traffic_control_or_stationary_jitter'
      ].hasAny([value]);
    }

    function isAllowedDashboardRecoveryState(value) {
      return [
        'none',
        'ready',
        'pending_replay',
        'completed_review',
        'invalid_session',
        'invalid_review',
        'vehicle_mismatch',
        'odometer_mismatch',
        'projection_invalid'
      ].hasAny([value]);
    }

    function isAllowedDashboardRecoveryReason(value) {
      return [
        'trip_recovery_none',
        'trip_recovery_ready',
        'trip_recovery_pending_replay_ready',
        'trip_recovery_completed_review_present',
        'trip_recovery_invalid_session',
        'trip_recovery_invalid_review_present',
        'trip_recovery_vehicle_mismatch',
        'trip_recovery_odometer_mismatch',
        'trip_recovery_odometer_projection_invalid'
      ].hasAny([value]);
    }

    function isAllowedMileageMode(value) {
      return [
        'manual',
        'gps_assisted',
        'workday',
        'employee_shift',
        'fleet_review',
        'customer_hidden'
      ].hasAny([value]);
    }

    function isAllowedDashboardSyncMode(value) {
      return [
        'device_retained',
        'local_only',
        'wifi_only',
        'wifi_and_mobile',
        'mobile_only',
        'firebase_backup',
        'company_sync'
      ].hasAny([value]);
    }

    function isAllowedGpsAssistState(value) {
      return [
        'off',
        'on',
        'gps_assisted',
        'battery_limited',
        'permission_denied',
        'unavailable'
      ].hasAny([value]);
    }

    function isAllowedDashboardGpsSignalQuality(value) {
      return [
        'no_samples',
        'healthy',
        'reduced',
        'poor',
        'interrupted',
        'unsafe'
      ].hasAny([value]);
    }

    function isAllowedDashboardGpsSignalReason(value) {
      return [
        'gps_signal_waiting_for_samples',
        'gps_signal_healthy',
        'gps_signal_reduced_but_usable',
        'gps_signal_poor_measurement_quality',
        'gps_signal_interrupted_by_gap',
        'gps_signal_unsafe_provider_evidence'
      ].hasAny([value]);
    }

    function isAllowedDashboardMapboxAssistState(value) {
      return [
        'disabled',
        'unavailable',
        'rate_limited',
        'rejected',
        'visual_only',
        'distance_review'
      ].hasAny([value]);
    }

    function isAllowedDashboardMapboxAssistReason(value) {
      return [
        'mapbox_assist_disabled',
        'mapbox_route_unavailable',
        'mapbox_rate_limited',
        'mapbox_http_failure',
        'mapbox_response_not_object',
        'mapbox_service_code_not_ok',
        'mapbox_routes_missing',
        'mapbox_routes_invalid',
        'invalid_map_assist_threshold',
        'mapbox_visual_only_no_trusted_mileage',
        'mapbox_visual_assist_only',
        'mapbox_distance_review_only'
      ].hasAny([value]);
    }

    function isAllowedDashboardMapboxTrustedMileageSource(value) {
      return [
        'none',
        'odometer',
        'gps_accepted'
      ].hasAny([value]);
    }

    function isAllowedDashboardStorageState(value) {
      return [
        'unknown',
        'green',
        'text_record_safe',
        'low_storage',
        'full',
        'local_only',
        'cloud_pending'
      ].hasAny([value]);
    }

    function isAllowedDashboardDeviceCapabilityState(value) {
      return [
        'unknown',
        'unavailable',
        'location_only',
        'foreground_ready',
        'background_ready',
        'motion_ready',
        'full_safety_assist'
      ].hasAny([value]);
    }

    function isAllowedDashboardSensorAssistState(value) {
      return [
        'unknown',
        'no_assist',
        'battery_available',
        'motion_available',
        'motion_battery_available'
      ].hasAny([value]);
    }

    function isAllowedDashboardDurableRecordBackupState(value) {
      return [
        'not_configured',
        'available',
        'pending_retry'
      ].hasAny([value]);
    }

    function isAllowedOdometerCalibrationState(value) {
      return [
        'unknown',
        'disabled',
        'insufficient_history',
        'stable',
        'review_recommended',
        'invalid'
      ].hasAny([value]);
    }

    function isAllowedOdometerUsageState(value) {
      return [
        'unknown',
        'disabled',
        'insufficient_history',
        'normal',
        'review_recommended',
        'invalid'
      ].hasAny([value]);
    }

    function hasValidDashboardTokenLists() {
      return (!request.resource.data.keys().hasAny(['dashboardWidgetTokens']) ||
          (request.resource.data.dashboardWidgetTokens is list &&
            request.resource.data.dashboardWidgetTokens.size() <= 12 &&
            request.resource.data.dashboardWidgetTokens.hasOnly([
              'start_day',
              'live_odometer',
              'stops',
              'pay',
              'profit',
              'miles',
              'hours',
              'expenses',
              'jobs',
              'materials',
              'payments',
              'maintenance'
            ]))) &&
        (!request.resource.data.keys().hasAny(['quickActionTokens']) ||
          (request.resource.data.quickActionTokens is list &&
            request.resource.data.quickActionTokens.size() <= 12 &&
            request.resource.data.quickActionTokens.hasOnly([
              'start_trip',
              'end_trip',
              'add_stop',
              'add_pickup',
              'add_dropoff',
              'add_job',
              'add_expense',
              'add_pay',
              'record_payment',
              'maintenance_log',
              'review_mileage'
            ])));
    }

    function isDashboardCommandCenterSummary() {
      return request.resource.data.schema ==
          'dashboard_command_center_summary_v1' &&
        request.resource.data.locationDataIncluded == false &&
        request.resource.data.rawModuleDataIncluded == false &&
        hasOnlyDashboardSummaryFields() &&
        hasRequiredDashboardSummaryFields() &&
        noLocationTrackingFields() &&
        noForbiddenSensitiveFields() &&
        hasValidDashboardSyncCounters() &&
        hasValidDashboardSummaryStrings() &&
        isAllowedDashboardMode(request.resource.data.dashboardMode) &&
        isAllowedDashboardWorkStyle(request.resource.data.workStyle) &&
        isAllowedDashboardStopDetectionMode(
          request.resource.data.stopDetectionMode
        ) &&
        isAllowedDashboardStopReviewReason(
          request.resource.data.stopReviewReasonCode
        ) &&
        isAllowedDashboardStopSignal(request.resource.data.stopSignal) &&
        isAllowedDashboardStopActionToken(
          request.resource.data.stopActionToken
        ) &&
        isAllowedDashboardStopClassificationReason(
          request.resource.data.stopClassificationReason
        ) &&
        request.resource.data.recommendedActivityRecognition is bool &&
        request.resource.data.requiresStrongerStopDebounce is bool &&
        isAllowedDashboardRecoveryState(request.resource.data.recoveryState) &&
        isAllowedDashboardRecoveryReason(request.resource.data.recoveryReason) &&
        request.resource.data.recoveryUserActionRequired is bool &&
        isAllowedMileageMode(request.resource.data.mileageMode) &&
        isAllowedDashboardSyncMode(request.resource.data.syncMode) &&
        isAllowedGpsAssistState(request.resource.data.gpsAssistState) &&
        isAllowedDashboardGpsSignalQuality(
          request.resource.data.gpsSignalQuality
        ) &&
        isAllowedDashboardGpsSignalReason(
          request.resource.data.gpsSignalReason
        ) &&
        request.resource.data.gpsSignalReviewRequired is bool &&
        isAllowedDashboardMapboxAssistState(
          request.resource.data.mapboxAssistState
        ) &&
        isAllowedDashboardMapboxAssistReason(
          request.resource.data.mapboxAssistReason
        ) &&
        request.resource.data.mapboxAssistReviewRequired is bool &&
        isAllowedDashboardMapboxTrustedMileageSource(
          request.resource.data.mapboxTrustedMileageSource
        ) &&
        (!request.resource.data.keys().hasAny(['mapboxRouteDistanceMiles']) ||
          (request.resource.data.mapboxRouteDistanceMiles is number &&
            request.resource.data.mapboxRouteDistanceMiles >= 0 &&
            request.resource.data.mapboxRouteDistanceMiles <= 12500)) &&
        (!request.resource.data.keys().hasAny(['mapboxRouteDeltaMiles']) ||
          (request.resource.data.mapboxRouteDeltaMiles is number &&
            request.resource.data.mapboxRouteDeltaMiles >= 0 &&
            request.resource.data.mapboxRouteDeltaMiles <= 12500)) &&
        request.resource.data.mapPreviewEnabled is bool &&
        request.resource.data.mapRouteHistorySavingEnabled is bool &&
        request.resource.data.mapRouteHistoryDailyBudgetMb is number &&
        request.resource.data.mapRouteHistoryDailyBudgetMb >= 0 &&
        request.resource.data.mapRouteHistoryDailyBudgetMb <= 2 &&
        request.resource.data.mapRouteHistorySampleIntervalSeconds is int &&
        request.resource.data.mapRouteHistorySampleIntervalSeconds >= 15 &&
        request.resource.data.mapRouteHistorySampleIntervalSeconds <= 300 &&
        request.resource.data.mapRouteHistoryState
          in ['disabled', 'budget_missing', 'budget_exceeded', 'within_budget'] &&
        request.resource.data.mapRouteHistoryEstimatedSamplesPerDay is int &&
        request.resource.data.mapRouteHistoryEstimatedSamplesPerDay >= 0 &&
        request.resource.data.mapRouteHistoryEstimatedSamplesPerDay <= 86400 &&
        request.resource.data.mapRouteHistoryEstimatedDailyMb is number &&
        request.resource.data.mapRouteHistoryEstimatedDailyMb >= 0 &&
        request.resource.data.mapRouteHistoryEstimatedDailyMb <= 10 &&
        isAllowedDashboardStorageState(request.resource.data.storageState) &&
        isAllowedDashboardDeviceCapabilityState(
          request.resource.data.deviceCapabilityState
        ) &&
        isAllowedDashboardSensorAssistState(
          request.resource.data.sensorAssistState
        ) &&
        isAllowedDashboardDurableRecordBackupState(
          request.resource.data.durableRecordBackupState
        ) &&
        isAllowedOdometerCalibrationState(
          request.resource.data.odometerCalibrationState
        ) &&
        (!request.resource.data.keys().hasAny(['odometerCalibrationSamples']) ||
          (request.resource.data.odometerCalibrationSamples is int &&
            request.resource.data.odometerCalibrationSamples >= 0 &&
            request.resource.data.odometerCalibrationSamples <= 999)) &&
        (!request.resource.data.keys().hasAny(['odometerCalibrationMultiplier']) ||
          (request.resource.data.odometerCalibrationMultiplier is number &&
            request.resource.data.odometerCalibrationMultiplier >= 0.8 &&
            request.resource.data.odometerCalibrationMultiplier <= 1.25)) &&
        isAllowedOdometerUsageState(
          request.resource.data.odometerUsageState
        ) &&
        (!request.resource.data.keys().hasAny(['odometerUsageReviewedDays']) ||
          (request.resource.data.odometerUsageReviewedDays is int &&
            request.resource.data.odometerUsageReviewedDays >= 0 &&
            request.resource.data.odometerUsageReviewedDays <= 999)) &&
        (!request.resource.data.keys().hasAny(['odometerUsageCurrentMiles']) ||
          (request.resource.data.odometerUsageCurrentMiles is number &&
            request.resource.data.odometerUsageCurrentMiles >= 0 &&
            request.resource.data.odometerUsageCurrentMiles <= 12500)) &&
        (!request.resource.data.keys().hasAny(['odometerUsageAverageDailyMiles']) ||
          (request.resource.data.odometerUsageAverageDailyMiles is number &&
            request.resource.data.odometerUsageAverageDailyMiles >= 0 &&
            request.resource.data.odometerUsageAverageDailyMiles <= 12500)) &&
        (!request.resource.data.keys().hasAny(['odometerUsageReviewThresholdMiles']) ||
          (request.resource.data.odometerUsageReviewThresholdMiles is number &&
            request.resource.data.odometerUsageReviewThresholdMiles >= 0 &&
            request.resource.data.odometerUsageReviewThresholdMiles <= 12500)) &&
        hasValidDashboardTokenLists() &&
        request.resource.data.odometerCalibrationAssistEnabled is bool &&
        request.resource.data.batteryGpsLimited is bool &&
        request.resource.data.reviewRequired is bool &&
        request.resource.data.authorizationRequired == true &&
        request.resource.data.authenticationImpliesAuthorization == false &&
        request.resource.data.employeeTrackingRequiresMutualConsent == true &&
        request.resource.data.locationSharingRequiresActiveOptIn == true &&
        request.resource.data.employerGodModeAllowed == false &&
        request.resource.data.preciseLocationIncluded == false &&
        request.resource.data.externalRoutesCanonical == false &&
        request.resource.data.odometerRemainsCanonical == true &&
        request.resource.data.externalServiceWritesAllowed == false &&
        request.resource.data.mapboxCanModifyTripLog == false &&
        request.resource.data.mapboxCanModifyOdometer == false &&
        request.resource.data.mapsRequiredForTracking == false &&
        request.resource.data.mapsRequireSeparateOptIn == true &&
        request.resource.data.mapRouteHistoryRequiresSeparateOptIn == true &&
        request.resource.data.gpsTrackingCanRunWithoutMaps == true &&
        request.resource.data.freeUserControlsDailyMapStorageBudget == true &&
        request.resource.data.mapboxRouteGeometryIncluded == false &&
        request.resource.data.rawMapRouteIncluded == false;
    }

    function noServerManagedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'plan',
        'cloudBytesUsed',
        'monthlyCloudBytesLimit',
        'exportCount',
        'monthlyExportLimit',
        'aiInputTokens',
        'aiOutputTokens',
        'functionCallCount',
        'billingStatus',
        'blockedReason',
        'riskScore',
        'abuseFlags',
        'quotaOverride',
      ]);
    }

    function keepsServerManagedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'cloudBytesUsed',
        'monthlyCloudBytesLimit',
        'exportCount',
        'monthlyExportLimit',
        'aiInputTokens',
        'aiOutputTokens',
        'functionCallCount',
        'billingStatus',
        'blockedReason',
        'riskScore',
        'abuseFlags',
        'quotaOverride',
      ]);
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) &&
        request.resource.data.uid == uid &&
        noServerManagedFieldsOnCreate() &&
        noForbiddenSensitiveFields();
      allow update: if isSelf(uid) &&
        request.resource.data.uid == resource.data.uid &&
        keepsServerManagedFields() &&
        noForbiddenSensitiveFields();
      allow delete: if false;

      match /mileageRecords/{recordId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) &&
          request.resource.data.createdByUid == uid &&
          request.resource.data.updatedByUid == uid &&
          isMileageOnlySummary() &&
          hasOnlyMileageSummaryFields() &&
          hasRequiredMileageSummaryFields() &&
          hasValidMileageSummaryValues() &&
          hasCoherentMileageSummaryDistance() &&
          request.resource.data.tripId == recordId &&
          !request.resource.data.keys().hasAny([
            'orgId',
            'organizationSharingConsent',
          ]);
        // Reviewed mileage is an audit record, not a mutable cloud draft.
        // Permit an exact replay by its creator so an interrupted upload can
        // be retried idempotently, but reject every material change.
        allow update: if isSelf(uid) &&
          exists(/databases/$(database)/documents/users/$(uid)/mileageRecords/$(recordId)) &&
          resource.data.createdByUid == uid &&
          request.resource.data == resource.data;
        allow delete: if false;
      }

      match /dashboardSummaries/{dashboardId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) &&
          request.resource.data.dashboardId == dashboardId &&
          request.resource.data.createdByUid == uid &&
          request.resource.data.updatedByUid == uid &&
          isDashboardCommandCenterSummary() &&
          !request.resource.data.keys().hasAny(['orgId']);
        allow update: if isSelf(uid) &&
          resource.data.createdByUid == uid &&
          request.resource.data.dashboardId == resource.data.dashboardId &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.updatedByUid == uid &&
          isDashboardCommandCenterSummary() &&
          !request.resource.data.keys().hasAny(['orgId']);
        allow delete: if false;
      }
    }

    match /usage/{uid}/months/{monthId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /abuseSignals/{signalId} {
      allow read, write: if false;
    }

    match /aiAbuseSecurityEvents/{eventId} {
      allow read, write: if false;
    }

    match /aiEnforcementActions/{actionId} {
      allow read, write: if false;
    }

    match /accountAbuseInstalls/{installId} {
      allow read, write: if false;
    }

    match /accountAbuseIpWindows/{ipWindowId} {
      allow read, write: if false;
    }

    match /accountCreationReviews/{reviewId} {
      allow read, write: if false;
    }

    match /orgs/{orgId} {
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        noServerManagedFieldsOnCreate();
      allow read: if isActiveMember(orgId);
      allow update: if isOwnerOrAdmin(orgId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        keepsServerManagedFields();
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isSelf(memberUid) || isOwnerOrAdmin(orgId);
        // A newly authenticated independent user must be able to enroll the
        // first owner member after creating their private workspace. The owner
        // may only enroll themself, as an active owner, and cannot use this
        // narrow bootstrap rule to add another person.
        allow create: if (
            isOwnerOrAdmin(orgId) ||
            (
              signedIn() &&
              request.auth.uid == memberUid &&
              get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid &&
              request.resource.data.uid == memberUid &&
              request.resource.data.orgId == orgId &&
              request.resource.data.status == 'active' &&
              request.resource.data.role == 'owner'
            )
          ) &&
          request.resource.data.uid == memberUid &&
          request.resource.data.orgId == orgId;
        allow update: if isOwnerOrAdmin(orgId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.orgId == resource.data.orgId;
        allow delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          (signedIn() && resource.data.email == request.auth.token.email);
        allow create: if isOwnerOrAdmin(orgId) &&
          request.resource.data.orgId == orgId &&
          request.resource.data.invitedByUid == request.auth.uid;
        allow update: if isOwnerOrAdmin(orgId) &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.invitedByUid == resource.data.invitedByUid;
        allow delete: if false;
      }

      match /uploadGrants/{grantId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          (isActiveMember(orgId) && resource.data.uid == request.auth.uid);
        allow write: if false;
      }

      match /storageQuotas/{uid} {
        allow read: if isOwnerOrAdmin(orgId) ||
          (isActiveMember(orgId) && isSelf(uid));
        allow write: if false;
      }

      match /exports/{exportId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAuditLog');
        allow write: if false;
      }

      match /syncManifests/{manifestId} {
        allow read: if isActiveMember(orgId);
        allow write: if false;
      }

      match /settings/{settingsId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if isActiveMember(orgId) &&
          request.resource.data.orgId == orgId &&
          (
            isOwnerOrAdmin(orgId) ||
            request.resource.data.ownerUid == request.auth.uid ||
            request.resource.data.createdByUid == request.auth.uid
          ) &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if isActiveMember(orgId) &&
          request.resource.data.orgId == resource.data.orgId &&
          (
            isOwnerOrAdmin(orgId) ||
            resource.data.ownerUid == request.auth.uid ||
            resource.data.createdByUid == request.auth.uid
          ) &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }

      match /expenseTelemetrySummaries/{summaryId} {
        allow read: if isOwnerOrAdmin(orgId);
        allow write: if false;
      }

      match /vehicles/{vehicleId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllVehicles') ||
          (hasPermission(orgId, 'viewAssignedVehicles') && assignedToMember());
        allow create: if hasPermission(orgId, 'manageVehicles') &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if hasPermission(orgId, 'editVehicleProfiles') &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllExpenses') ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasModule(orgId, 'expenses') &&
          (
            hasPermission(orgId, 'recordExpenses') ||
            hasPermission(orgId, 'addOwnReceipts') ||
            hasPermission(orgId, 'addCompanyExpenses')
          ) &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'editCompanyExpenses') ||
            (
              hasPermission(orgId, 'editOwnReceipts') &&
              resource.data.createdByUid == request.auth.uid
            )
          ) &&
          keepsCreator();
        allow delete: if isOwnerOrAdmin(orgId);
      }

      match /mileageRecords/{recordId} {
        allow read: if (
            isOwnerOrAdmin(orgId) ||
            hasPermission(orgId, 'viewFleetMileageReports')
          ) && resource.data.organizationSharingConsent == true ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasPermission(orgId, 'recordMileage') &&
          writesOwnCreate() &&
          isMileageOnlySummary() &&
          hasOnlyMileageSummaryFields() &&
          hasRequiredMileageSummaryFields() &&
          hasValidMileageSummaryValues() &&
          hasCoherentMileageSummaryDistance() &&
          request.resource.data.tripId == recordId &&
          request.resource.data.orgId == orgId &&
          request.resource.data.organizationSharingConsent == true;
        // An employer/fleet role can view consented mileage but cannot alter
        // a driver's reviewed record. The creator may only replay an exact
        // document after a client-side retry ambiguity.
        allow update: if exists(/databases/$(database)/documents/orgs/$(orgId)/mileageRecords/$(recordId)) &&
          resource.data.createdByUid == request.auth.uid &&
          request.resource.data == resource.data;
        allow delete: if false;
      }

      match /dashboardSummaries/{dashboardId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if isActiveMember(orgId) &&
          request.resource.data.dashboardId == dashboardId &&
          request.resource.data.orgId == orgId &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.updatedByUid == request.auth.uid &&
          isDashboardCommandCenterSummary();
        allow update: if isActiveMember(orgId) &&
          resource.data.createdByUid == request.auth.uid &&
          request.resource.data.dashboardId == resource.data.dashboardId &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.updatedByUid == request.auth.uid &&
          isDashboardCommandCenterSummary();
        allow delete: if false;
      }

      match /jobs/{jobId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllJobs') ||
          (
            hasPermission(orgId, 'viewAssignedJobs') &&
            request.auth.uid in resource.data.assignedMemberIds
          );
        allow create: if hasPermission(orgId, 'createJobs') &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if hasPermission(orgId, 'editJobs') &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }

      match /estimates/{estimateId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'createEstimates') ||
          hasPermission(orgId, 'sendEstimates') ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasPermission(orgId, 'createEstimates') &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'createEstimates') ||
            hasPermission(orgId, 'approveEstimates') ||
            hasPermission(orgId, 'sendEstimates')
          ) &&
          keepsCreator();
        allow delete: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'createInvoices') ||
          hasPermission(orgId, 'sendInvoices') ||
          resource.data.createdByUid == request.auth.uid;
        allow create: if hasPermission(orgId, 'createInvoices') &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'createInvoices') ||
            hasPermission(orgId, 'approveInvoices') ||
            hasPermission(orgId, 'recordPayments') ||
            hasPermission(orgId, 'sendInvoices')
          ) &&
          keepsCreator();
        allow delete: if false;
      }

      match /inventoryItems/{itemId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllInventory') ||
          (
            hasPermission(orgId, 'viewAssignedInventory') &&
            inventoryAssignedToMember()
          );
        allow create: if hasPermission(orgId, 'manageInventory') &&
          writesOwnCreate();
        allow update: if (
            hasPermission(orgId, 'manageInventory') ||
            hasPermission(orgId, 'addStock') ||
            hasPermission(orgId, 'useMaterials') ||
            hasPermission(orgId, 'transferMaterials') ||
            hasPermission(orgId, 'adjustInventoryCounts')
          ) &&
          keepsCreator();
        allow delete: if false;
      }

      match /inventoryTransactions/{transactionId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllInventory') ||
          (
            hasPermission(orgId, 'viewAssignedInventory') &&
            inventoryAssignedToMember()
          );
        allow create: if (
            hasPermission(orgId, 'addStock') ||
            hasPermission(orgId, 'useMaterials') ||
            hasPermission(orgId, 'transferMaterials') ||
            hasPermission(orgId, 'adjustInventoryCounts')
          ) &&
          writesOwnCreate();
        allow update, delete: if false;
      }

      match /maintenanceRecords/{recordId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewAllMaintenance') ||
          (
            hasPermission(orgId, 'viewAssignedMaintenance') &&
            request.auth.uid in resource.data.assignedMemberIds
          );
        allow create: if hasPermission(orgId, 'logMaintenance') &&
          writesOwnCreate();
        allow update: if hasPermission(orgId, 'editMaintenanceRecords') &&
          keepsCreator();
        allow delete: if false;
      }

      match /financialSummaries/{summaryId} {
        allow read: if isOwnerOrAdmin(orgId) ||
          hasPermission(orgId, 'viewFinancials') ||
          hasPermission(orgId, 'viewProfitLoss');
        allow write: if isOwnerOrAdmin(orgId);
      }

      match /records/{recordId} {
        allow read: if isActiveMember(orgId) &&
          resource.data.privateToOwner != true;
        allow create: if isActiveMember(orgId) &&
          writesOwnCreate() &&
          noForbiddenSensitiveFields();
        allow update: if isActiveMember(orgId) &&
          keepsCreator() &&
          noForbiddenSensitiveFields();
        allow delete: if false;
      }
    }

    match /catalogPacks/{packId} {
      allow read: if true;
      allow write: if false;

      match /manifests/{versionId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /vendorRegistry/{vendorId} {
      allow read: if true;
      allow write: if false;

      match /profiles/{profileId} {
        allow read: if true;
        allow write: if false;
      }

      match /aliases/{aliasId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /parserHealth/{parserVersion} {
      allow read, write: if false;
    }

    match /catalogHealth/{healthId} {
      allow read, write: if false;
    }

    match /sharedCorrectionCandidates/{candidateId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
