**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local editor/device launch settings
.vscode/*
!.vscode/launch.json

# Codex/local review artifacts
.codex_screenshots/
asset_reviews/
.external_datasets/
firebase_emulator_tests/node_modules/
